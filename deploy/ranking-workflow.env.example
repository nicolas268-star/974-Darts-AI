# Server variables. Use isolated preview project values; never reuse production keys.
SUPABASE_URL=https://preview-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server
NEXT_PUBLIC_SUPABASE_URL=https://preview-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-preview-public-key
INTERNAL_API_TOKEN=replace-with-random-server-secret
ADMIN_USER_ID=replace-with-preview-admin-auth-uuid
RANKING_WORKFLOW_ENABLED=true
RANKING_EMAIL_ENABLED=false
# Required only when real notification sending is explicitly activated.
RANKING_SITE_ORIGIN=https://preview.example.invalid
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
